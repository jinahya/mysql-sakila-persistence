        <filtering>true</filtering>
      </testResource>
    </testResources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>de.empulse.eclipselink</groupId>
          <artifactId>staticweave-maven-plugin</artifactId>
          <version>1.0.0</version>
        </plugin>
        <plugin>
          <groupId>com.mysema.maven</groupId>
          <artifactId>apt-maven-plugin</artifactId>
          <version>1.1.3</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-javadoc-plugin/versions -->
          <version>3.12.0</version>
          <configuration>
            <additionalOptions>
              <additionalOption>-Xdoclint:${doclint},-missing</additionalOption>
            </additionalOptions>
            <failOnError>true</failOnError>
            <failOnWarnings>true</failOnWarnings>
            <!-- A bare `javadoc:javadoc` / `javadoc:test-javadoc` from the command line lands in the -->
            <!-- default-cli execution, which no reportSet reaches and which cannot be scoped per goal. -->
            <!-- So this level carries what BOTH goals can live with: the test sources are all -->
            <!-- package-private, which `protected` finds nothing in, and their constructors and @Test -->
            <!-- methods carry no javadoc by convention. The strict settings live in the site's main -->
            <!-- reportSet below, which is what actually gates the published apidocs. -->
            <show>package</show>
            <!-- The generated static metamodel is not ours to document: every member of it carries -->
            <!-- a bare @see and no main description, which -Xdoclint:all reports. It shares the -->
            <!-- package with the entities, so excludePackageNames cannot reach it; exclude by file. -->
            <sourceFileExcludes>
              <sourceFileExclude>**/*_.java</sourceFileExclude>
            </sourceFileExcludes>
            <!-- The exclusion above only keeps the metamodel off the list of files to document. With a -->
            <!-- module-info.java, javadoc runs in module mode and reads the whole module from the source -->
            <!-- path it is given, generated sources included, so the metamodel was linted all the -->
            <!-- same, and its javadoc, which quotes each @NamedQuery verbatim, fails on a `<` as -->
            <!-- malformed HTML. Without a source path javadoc reads the listed files only. `sourcepath` -->
            <!-- cannot do this instead: javadoc and test-javadoc share it, so it would point both at -->
            <!-- the same directory. -->
            <disableSourcepathUsage>true</disableSourcepathUsage>
            <links>
<!--              <link>https://www.javadoc.io/doc/jakarta.platform/jakarta.jakartaee-api/${version.jakarta.jakartaee-bom}</link>-->
<!--              <link>https://jakarta.ee/specifications/persistence/3.2/apidocs/jakarta.persistence</link>-->
              <link>https://jakarta.ee/specifications/platform/11/apidocs/</link>
            </links>
            <release>${maven.compiler.testRelease}</release>
            <tags>
              <tag>
                <name>apiNote</name>
                <placement>a</placement>
                <head>API Note:</head>
              </tag>
              <tag>
                <name>implSpec</name>
                <placement>a</placement>
                <head>Implementation Requirements:</head>
              </tag>
              <tag>
                <name>implNote</name>
                <placement>a</placement>
                <head>Implementation Note:</head>
              </tag>
            </tags>
          </configuration>
          <executions>
            <!-- Bound by io.github.jinahya:central-parent's `central` profile. In module mode the jar goal -->
            <!-- passes the generated sources in its patched module path whatever disableSourcepathUsage says, so the -->
            <!-- metamodel, which quotes each @NamedQuery verbatim, fails on a `<` as malformed HTML. As the -->
            <!-- site's main reportSet does, narrow the source path to the hand-written sources; this -->
            <!-- execution runs the jar goal alone, so test-javadoc is not misdirected. -->
            <execution>
              <id>attach-javadocs</id>
              <configuration>
                <disableSourcepathUsage>false</disableSourcepathUsage>
                <sourcepath>${project.build.sourceDirectory}</sourcepath>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-jar-plugin/versions -->
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-project-info-reports-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-project-info-reports-plugin/versions -->
          <version>3.9.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-site-plugin/versions -->
          <version>3.21.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>versions-maven-plugin</artifactId>
          <version>2.22.0</version>
          <configuration>
            <processDependencyManagementTransitive>false</processDependencyManagementTransitive>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>sonar-maven-plugin</artifactId>
          <!--          <version>3.11.922</version>-->
          <version>4.0.0.4121</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>0.8.15</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${version.org.projectlombok}</version>
            </path>
            <path><!-- the static metamodel generator of the active persistence provider -->
              <groupId>${metamodel.generator.groupId}</groupId>
              <artifactId>${metamodel.generator.artifactId}</artifactId>
              <version>${metamodel.generator.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Xlint</arg>
            <!-- the hibernate processor writes an entity index, entity/index/*, into the generated sources, which
                 IntelliJ's maven resource builder then fails to copy -->
            <arg>-Aindex=false</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-dependency-convergence</id>
            <configuration>
              <rules>
                <dependencyConvergence />
              </rules>
            </configuration>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
          <execution>
            <id>enforce-require-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21.0.0,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-require-maven-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!-- a -P naming a profile that does not exist is silently ignored by Maven; this turns
                 that into a build failure. The provider profile ids are named from
                 _mvn_jakarta_ee_11.sh and from the CI matrix, so a rename that misses one of them
                 would otherwise just run the default provider twice and look green. -->
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist />
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        Sets a property per dependency, of its jar's path, for the argLine of surefire and failsafe to load Mockito as
        a -javaagent. Mockito's inline mock maker needs an Instrumentation; given no agent, it attaches one to the
        running JVM, which JEP 451 (JDK 21) warns about and is to disallow by default. An agent named on the command
        line stays allowed.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${version.maven-dependency}</version>
        <executions>
          <execution>
            <id>dependency-properties</id>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${version.maven-surefire}</version>
        <configuration>
          <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
          <excludes>
            <!--            <exclude>**/*IT.java</exclude> &lt;!&ndash; 이게 왜 필요한지 확인 필요 &ndash;&gt;-->
          </excludes>
          <skipAfterFailureCount>1</skipAfterFailureCount>
          <systemPropertyVariables>
            <eclipselink.woven>${eclipselink.woven}</eclipselink.woven>
          </systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <!--
        The randomizers and persisters are compiled with the tests, which use them, and packaged here as a second jar,
        classified test-companion, which a consumer takes at <scope>test</scope>. A classified jar shares this pom, in
        which the libraries they need, podam and jinahya-persistence-test-utils, are test-scoped, so it brings none of
        them; the consumer declares its own. The includes are what keep the tests and persistence.xml out
        of it.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-companion-jar</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classesDirectory>${project.build.testOutputDirectory}</classesDirectory>
              <classifier>test-companion</classifier>
              <includes>
                <include>**/*_Randomizer.class</include>
                <include>**/*_Randomizer$*.class</include>
                <include>**/*_Persister.class</include>
                <include>**/*_Persister$*.class</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.7.1</version>
        <configuration>
          <licenseName>apache_v2</licenseName>
          <!-- A .sql header opens and closes with a dash after the comment marker, the mysql style, in every module:
               the default sql style would open and close with three dashes, which MySQL does not take for a comment. -->
          <extraExtensions>
            <sql>mysql</sql>
          </extraExtensions>
          <!-- src alone: by default the plugin also walks target/generated-sources, and would put a header on every
               generated metamodel class, which the next build throws away. -->
          <roots>
            <root>src</root>
          </roots>
          <excludes>
            <exclude>**/*.json</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>default-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>default-report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jxr-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <reportSets>
          <reportSet>
            <id>main</id>
            <configuration>
              <!-- The published apidocs: public API only, and every element of it documented. -->
              <show>protected</show>
              <additionalOptions combine.self="override">
                <additionalOption>-Xdoclint:${doclint}</additionalOption>
              </additionalOptions>
              <!-- In module mode javadoc reads the whole module from its source path, so the generated -->
              <!-- metamodel there would be linted with -missing on, which it cannot pass. This reportSet -->
              <!-- runs javadoc-no-fork alone, so here, unlike the plugin level, the source path can be -->
              <!-- narrowed to the hand-written sources without misdirecting test-javadoc. -->
              <disableSourcepathUsage>false</disableSourcepathUsage>
              <sourcepath>${project.build.sourceDirectory}</sourcepath>
            </configuration>
            <reports>
              <report>javadoc-no-fork</report>
            </reports>
          </reportSet>
          <reportSet>
            <id>tests</id>
            <configuration>
              <!-- Every test class is package-private, so the default `protected` finds nothing to -->
              <!-- document, and javadoc reports that as an error. -->
              <show>package</show>
              <!-- Package-private constructors and @Test methods carry no javadoc by convention, so -->
              <!-- check references and syntax rather than presence. combine.self is required: without -->
              <!-- it Maven merges the list and the plugin-level -Xdoclint:${doclint} comes along too. -->
              <additionalOptions combine.self="override">
                <additionalOption>-Xdoclint:all,-missing</additionalOption>
              </additionalOptions>
              <!-- test-javadoc links the test apidocs to the main ones, ../apidocs, whenever those exist, -->
              <!-- and no parameter turns that off. The test sources are documented in the unnamed module -->
              <!-- and the main ones in a named module, which javadoc warns of, outside doclint. So a -->
              <!-- warning does not fail this report; an error, a broken reference among them, does. -->
              <failOnWarnings>false</failOnWarnings>
            </configuration>
            <reports>
              <report>test-javadoc-no-fork</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
        <configuration>
          <!-- Unsupported targetJdk value '21'. -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <reportSets>
          <reportSet>
            <reports>
              <report>report</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>

  <profiles>
    <profile>
      <id>failsafe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${version.maven-failsafe}</version>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar}</argLine>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <skipAfterFailureCount>1</skipAfterFailureCount>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- ============================================================== persistence provider ==== -->
    <!-- The only implementation axis in this build. The other spec has a single implementation
         (Hibernate Validator + Expressly for Jakarta Validation), pinned to its Jakarta EE 11
         aligned release in <properties>; there is nothing to choose there, so it has no profile.
         These two profiles do not choose a VERSION either: both provider versions live in
         <properties>, one per provider. A profile decides only which provider is on the test
         classpath, and which metamodel generator the annotation processor path uses. -->
    <profile>
      <id>jakarta-ee-11-hibernate-orm</id>
      <!-- https://hibernate.org/orm/releases/ -->
      <!-- Jakarta Persistence: 3.2 / Jakarta EE: 11; version: version.org.hibernate.orm -->
      <!-- the provider defaults in <properties> are this profile's; it only adds the dependency -->
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <dependencies>
        <dependency>
          <groupId>org.hibernate.orm</groupId>
          <artifactId>hibernate-core</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jakarta-ee-11-eclipselink</id>
      <!-- https://eclipse.dev/eclipselink/releases/index.html -->
      <!-- Jakarta Persistence: 3.2 / Jakarta EE: 11; version: version.org.eclipse.persistence -->
      <properties>
        <persistence-unit.provider>org.eclipse.persistence.jpa.PersistenceProvider</persistence-unit.provider>
        <!--
          This profile deliberately does NOT override the metamodel generator: it inherits
          hibernate-jpamodelgen from the root <properties>, and EclipseLink is the runtime provider only.

          EclipseLink's own processor is commented out below. It works, but it reads a persistence.xml at
          annotation-processing time and generates nothing without one — and the annotation processor path
          sees main resources, not test resources. Using it therefore forces the persistence.xml
          into src/main/resources/META-INF, which is also what gets packaged: the published jars then carry
          the test descriptor, with the H2 datasource, the sa/root credentials, hbm2ddl.auto=create-drop
          and whichever <provider> the releasing profile happened to bake in. Spring's
          DefaultPersistenceUnitManager reads classpath*:META-INF/persistence.xml — every jar — so that
          descriptor is in scope for any consumer, which is the opposite of what a mapping library should
          ship. Keeping the descriptor under src/test/resources keeps the jars to entities and metamodel.

          hibernate-jpamodelgen reads @Entity directly and needs no descriptor, and the canonical static
          metamodel is defined by the specification (Jakarta Persistence 3.2, 6.2), so the Film_ classes
          it emits are provider-neutral and EclipseLink runs against them unchanged. Verified in the sibling
          oracle-sample-schemas-persistence: both providers green, with the descriptors in src/test/resources.

          What this costs: the EclipseLink profile no longer exercises EclipseLink's metamodel processor.
          It still exercises EclipseLink as the persistence provider — every *_Persistence_Test and
          *_Persistence_IT runs against it — which is the behavioural difference this profile exists for.

          To go back, uncomment the three properties AND move META-INF back to
          src/main/resources; neither half works without the other.
        -->
        <!--        <metamodel.generator.groupId>org.eclipse.persistence</metamodel.generator.groupId>-->
        <!--        <metamodel.generator.artifactId>org.eclipse.persistence.jpa.modelgen.processor</metamodel.generator.artifactId>-->
        <!--        <metamodel.generator.version>${version.org.eclipse.persistence}</metamodel.generator.version>-->
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.persistence</groupId>
          <artifactId>org.eclipse.persistence.jpa</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
